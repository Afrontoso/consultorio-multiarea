PORT=3333
NODE_ENV=development

# Allowlist de CORS (origens separadas por vírgula). Obrigatória em produção.
# Em dev, se vazio, assume http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# Postgres (Supabase)
# Em produção use a role NÃO-superuser `consultorio_api` (packages/db/prisma/roles.sql),
# senão o Postgres ignora as policies de RLS.
DATABASE_URL=postgresql://user:pass@localhost:5432/consultorio?schema=public

# Firebase Admin (service account JSON inline)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Redis (Upstash)
REDIS_URL=

# Resend (vazio = emails apenas logados)
RESEND_API_KEY=
# Remetente dos emails transacionais (precisa de domínio verificado no Resend)
EMAIL_FROM="Consultório <onboarding@resend.dev>"

# Criptografia dos campos sensíveis do paciente (notes, birthDate) — AES-256.
# Chave de 32 bytes em base64. Gerar com: openssl rand -base64 32
# Obrigatória em produção. ATENÇÃO: perder a chave torna os dados irrecuperáveis.
FIELD_ENCRYPTION_KEY=

# Emails com acesso ao painel de plataforma (/super-admin), separados por vírgula.
# Vazio = ninguém tem acesso (fail-safe).
SUPER_ADMIN_EMAILS=
